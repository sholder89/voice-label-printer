# Copy this to .env in the server/ directory before running docker compose
LABEL_TOKEN=change-me-to-something-secret

# ── Optional tuning ───────────────────────────────────────────────────────────
# Comments must be on their own line. Compose's env_file parser does not strip
# a trailing "# ..." from a value, so `MAX_PENDING_JOBS=20  # note` is read as
# the literal string "20  # note" and int() raises on startup.

# Reject new jobs if this many are already queued
MAX_PENDING_JOBS=20

# Reject label text longer than this many characters
MAX_TEXT_LEN=200
